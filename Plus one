public class Solution {
    public int[] plusOne(int[] digits) {
        int n = digits.length;
        
        // Loop from the last digit to the first digit
        for (int i = n - 1; i >= 0; i--) {
            // If the digit is less than 9, increment and return the array immediately
            if (digits[i] < 9) {
                digits[i]++;
                return digits;
            }
            // If the digit is 9, it rolls over to 0, and the carry moves left
            digits[i] = 0;
        }
        
        // If the loop finishes, all digits were 9 (e.g., [9, 9, 9] ->)
        // We need a new array with an extra space (e.g., [1, 0, 0, 0])
        int[] result = new int[n + 1];
        result[0] = 1; // By default, Java initializes all other elements to 0
        
        return result;
    }
}
