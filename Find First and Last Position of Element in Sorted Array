class Solution {
    public int[] searchRange(int[] nums, int target) {
        int[] result = new int[]{-1, -1};
        
        // Find the first occurrence
        result[0] = findBound(nums, target, true);
        
        // If the first occurrence doesn't exist, the target is not in the array
        if (result[0] != -1) {
            // Find the last occurrence
            result[1] = findBound(nums, target, false);
        }
        
        return result;
    }
    
    private int findBound(int[] nums, int target, boolean isFirst) {
        int left = 0;
        int right = nums.length - 1;
        int bound = -1;
        
        while (left <= right) {
            int mid = left + (right - left) / 2;
            
            if (nums[mid] == target) {
                bound = mid; // Potential match found
                if (isFirst) {
                    right = mid - 1; // Keep searching to the left for the first position
                } else {
                    left = mid + 1;  // Keep searching to the right for the last position
                }
            } else if (nums[mid] < target) {
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }
        
        return bound;
    }
}
