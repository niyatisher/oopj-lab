class Solution {
    public String countAndSay(int n) {
        // Base case: the first term of the sequence is always "1"
        String current = "1";
        
        // Generate the sequence iteratively from 2 up to n
        for (int i = 2; i <= n; i++) {
            StringBuilder next = new StringBuilder();
            int length = current.length();
            int count = 1;
            
            for (int j = 0; j < length; j++) {
                // Check if the next character is the same as the current one
                if (j + 1 < length && current.charAt(j) == current.charAt(j + 1)) {
                    count++;
                } else {
                    // Append the count followed by the digit character itself
                    next.append(count).append(current.charAt(j));
                    count = 1; // Reset count for the next unique character
                }
            }
            // Move to the next string in the sequence
            current = next.toString();
        }
        
        return current;
    }
}
