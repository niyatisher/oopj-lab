public class Solution {
    private int[] rows = new int[9];
    private int[] cols = new int[9];
    private int[][] boxes = new int[3][3];

    public void solveSudoku(char[][] board) {
        // Step 1: Initialize masks with existing numbers on the board
        for (int i = 0; i < 9; i++) {
            for (int j = 0; j < 9; j++) {
                if (board[i][j] != '.') {
                    int val = board[i][j] - '1';
                    int mask = 1 << val;
                    rows[i] |= mask;
                    cols[j] |= mask;
                    boxes[i / 3][j / 3] |= mask;
                }
            }
        }
        // Step 2: Start backtracking
        solve(board, 0, 0);
    }

    private boolean solve(char[][] board, int r, int c) {
        // If we reach column 9, move to the next row
        if (c == 9) {
            r++;
            c = 0;
        }
        // If we process all rows, the puzzle is solved
        if (r == 9) return true;
        // Skip pre-filled cells
        if (board[r][c] != '.') return solve(board, r, c + 1);

        // Try placing digits from 1 to 9
        for (int val = 0; val < 9; val++) {
            int mask = 1 << val;
            
            // Check if 'val + 1' is already used in row, col, or box
            if ((rows[r] & mask) == 0 && (cols[c] & mask) == 0 && (boxes[r / 3][c / 3] & mask) == 0) {
                // Set bits (place the number)
                board[r][c] = (char) ('1' + val);
                rows[r] |= mask;
                cols[c] |= mask;
                boxes[r / 3][c / 3] |= mask;

                if (solve(board, r, c + 1)) return true;

                // Clear bits (backtrack)
                board[r][c] = '.';
                rows[r] &= ~mask;
                cols[c] &= ~mask;
                boxes[r / 3][c / 3] &= ~mask;
            }
        }
        return false;
    }
}
