import java.util.HashMap;
import java.util.Map;

public class Solution {
    // Memoization map to store calculated states
    private Map<String, Boolean> memo = new HashMap<>();

    public boolean isScramble(String s1, String s2) {
        // Base Case: If strings are equal, they are scrambled copies
        if (s1.equals(s2)) {
            return true;
        }

        // Base Case: Length mismatch means they cannot be scrambled
        if (s1.length() != s2.length()) {
            return false;
        }

        // Unique key for the current state lookup
        String key = s1 + "_" + s2;
        if (memo.containsKey(key)) {
            return memo.get(key);
        }

        int n = s1.length();
        
        // Optimization: Quick check if both strings contain the exact same characters
        int[] count = new int[26];
        for (int i = 0; i < n; i++) {
            count[s1.charAt(i) - 'a']++;
            count[s2.charAt(i) - 'a']--;
        }
        for (int i = 0; i < 26; i++) {
            if (count[i] != 0) {
                memo.put(key, false);
                return false;
            }
        }

        // Try splitting the strings at every possible index 'i'
        for (int i = 1; i < n; i++) {
            // Case 1: Substrings are NOT swapped
            if (isScramble(s1.substring(0, i), s2.substring(0, i)) && 
                isScramble(s1.substring(i), s2.substring(i))) {
                memo.put(key, true);
                return true;
            }

            // Case 2: Substrings ARE swapped
            if (isScramble(s1.substring(0, i), s2.substring(n - i)) && 
                isScramble(s1.substring(i), s2.substring(0, n - i))) {
                memo.put(key, true);
                return true;
            }
        }

        memo.put(key, false);
        return false;
    }
}
