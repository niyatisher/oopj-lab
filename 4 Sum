import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class Solution {
    public List<List<Integer>> fourSum(int[] nums, int target) {
        List<List<Integer>> result = new ArrayList<>();
        if (nums == null || nums.length < 4) {
            return result;
        }

        // Step 1: Sort the array
        Arrays.sort(nums);
        int n = nums.length;

        // Loop for the first element
        for (int i = 0; i < n - 3; i++) {
            // Skip duplicate first elements
            if (i > 0 && nums[i] == nums[i - 1]) continue;

            // Pruning 1: Minimum possible sum is greater than target -> no valid quadruplet ahead
            long minSum1 = (long) nums[i] + nums[i + 1] + nums[i + 2] + nums[i + 3];
            if (minSum1 > target) break;

            // Pruning 2: Maximum possible sum with this nums[i] is less than target -> skip this nums[i]
            long maxSum1 = (long) nums[i] + nums[n - 1] + nums[n - 2] + nums[n - 3];
            if (maxSum1 < target) continue;

            // Loop for the second element
            for (int j = i + 1; j < n - 2; j++) {
                // Skip duplicate second elements
                if (j > i + 1 && nums[j] == nums[j - 1]) continue;

                // Pruning 3: Minimum sum for fixed i and j is too large
                long minSum2 = (long) nums[i] + nums[j] + nums[j + 1] + nums[j + 2];
                if (minSum2 > target) break;

                // Pruning 4: Maximum sum for fixed i and j is too small
                long maxSum2 = (long) nums[i] + nums[j] + nums[n - 1] + nums[n - 2];
                if (maxSum2 < target) continue;

                // Step 2 & 3: Two-pointer search for the remaining two elements
                int left = j + 1;
                int right = n - 1;

                while (left < right) {
                    long currentSum = (long) nums[i] + nums[j] + nums[left] + nums[right];

                    if (currentSum == target) {
                        result.add(Arrays.asList(nums[i], nums[j], nums[left], nums[right]));

                        // Skip duplicate left and right elements
                        while (left < right && nums[left] == nums[left + 1]) left++;
                        while (left < right && nums[right] == nums[right - 1]) right--;

                        left++;
                        right--;
                    } else if (currentSum < target) {
                        left++;
                    } else {
                        right--;
                    }
                }
            }
        }

        return result;
    }
}
