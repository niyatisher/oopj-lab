class Solution {
    public int sortPermutation(int[] nums) {
        // Initialize ans to -1 (in binary, -1 has all bits set to 1)
        int ans = -1;
        boolean isSorted = true;
        
        for (int i = 0; i < nums.length; i++) {
            // Check if the current element is misplaced
            if (nums[i] != i) {
                isSorted = false;
                ans &= nums[i]; // Accumulate the bitwise AND
            }
        }
        
        // If it's already sorted, return 0; otherwise return the accumulated bitwise AND
        return isSorted ? 0 : ans;
    }
}
