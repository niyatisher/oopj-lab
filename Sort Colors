class Solution {
    public void sortColors(int[] nums) {
        // Pointer for the next position of 0 (red)
        int low = 0;
        // Pointer to traverse the array
        int mid = 0;
        // Pointer for the next position of 2 (blue)
        int high = nums.length - 1;

        while (mid <= high) {
            if (nums[mid] == 0) {
                // If the element is 0, swap it with the element at 'low'
                swap(nums, low, mid);
                low++;
                mid++;
            } else if (nums[mid] == 1) {
                // If the element is 1, it's already in the correct middle section
                mid++;
            } else if (nums[mid] == 2) {
                // If the element is 2, swap it with the element at 'high'
                swap(nums, mid, high);
                high--;
                // Note: mid is not incremented here because the swapped element 
                // from 'high' hasn't been processed yet.
            }
        }
    }

    private void swap(int[] nums, int i, int j) {
        int temp = nums[i];
        nums[i] = nums[j];
        nums[j] = temp;
    }
}
