class Solution {
    public boolean isNumber(String s) {
        boolean seenDigit = false;
        boolean seenDot = false;
        boolean seenExp = false;
        
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            
            if (Character.isDigit(c)) {
                seenDigit = true;
            } else if (c == '+' || c == '-') {
                // Sign is only valid at the beginning or right after an exponent 'e' or 'E'
                if (i > 0 && s.charAt(i - 1) != 'e' && s.charAt(i - 1) != 'E') {
                    return false;
                }
            } else if (c == '.') {
                // A dot is invalid if we already saw a dot or an exponent
                if (seenDot || seenExp) {
                    return false;
                }
                seenDot = true;
            } else if (c == 'e' || c == 'E') {
                // An exponent is invalid if we already saw an exponent or if no digits came before it
                if (seenExp || !seenDigit) {
                    return false;
                }
                seenExp = true;
                // Reset seenDigit to ensure there is at least one digit *after* the exponent
                seenDigit = false; 
            } else {
                // Any other character is invalid
                return false;
            }
        }
        
        // The string is valid only if we have processed at least one digit
        return seenDigit;
    }
}
