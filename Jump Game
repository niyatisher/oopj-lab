class Solution {
    public int jump(int[] nums) {
        if (nums == null || nums.length <= 1) {
            return 0;
        }

        int jumps = 0;
        int currentEnd = 0;
        int farthest = 0;

        // Loop up to nums.length - 1 because we don't need to jump from the last index
        for (int i = 0; i < nums.length - 1; i++) {
            // Track the furthest index reachable
            farthest = Math.max(farthest, i + nums[i]);

            // If we reached the end of the range for the current jump
            if (i == currentEnd) {
                jumps++;
                currentEnd = farthest;

                // Early exit if we can already reach or exceed the last index
                if (currentEnd >= nums.length - 1) {
                    break;
                }
            }
        }

        return jumps;
    }
}
