public class Solution {
    private int count = 0;

    public int totalNQueens(int n) {
        count = 0; // Reset count for each test case
        
        // Tracks columns and diagonals where queens are already placed
        boolean[] cols = new boolean[n];
        boolean[] diag1 = new boolean[2 * n]; // For row + col (anti-diagonal)
        boolean[] diag2 = new boolean[2 * n]; // For row - col + n (main diagonal)
        
        backtrack(0, n, cols, diag1, diag2);
        return count;
    }
    
    private void backtrack(int row, int n, boolean[] cols, boolean[] diag1, boolean[] diag2) {
        // Base case: If we reached the end row, we found a valid solution
        if (row == n) {
            count++;
            return;
        }
        
        for (int col = 0; col < n; col++) {
            int d1 = row + col;
            int d2 = row - col + n;
            
            // Check if placing a queen here causes any conflict
            if (cols[col] || diag1[d1] || diag2[d2]) {
                continue; 
            }
            
            // Place the queen (mark configurations as occupied)
            cols[col] = true;
            diag1[d1] = true;
            diag2[d2] = true;
            
            // Recurse to the next row
            backtrack(row + 1, n, cols, diag1, diag2);
            
            // Backtrack (unmark configurations)
            cols[col] = false;
            diag1[d1] = false;
            diag2[d2] = false;
        }
    }
}
