import java.util.Stack;

public class Solution {
    public String simplifyPath(String path) {
        // Split the path by one or more slashes
        String[] components = path.split("/");
        Stack<String> stack = new Stack<>();

        for (String component : components) {
            // If the component is empty or a single dot, do nothing
            if (component.isEmpty() || component.equals(".")) {
                continue;
            }
            // If it's a double dot, pop from the stack if it's not empty (go up a directory)
            if (component.equals("..")) {
                if (!stack.isEmpty()) {
                    stack.pop();
                }
            } else {
                // For any other valid directory/file name (including '...', '....', etc.)
                stack.push(component);
            }
        }

        // Build the simplified canonical path
        StringBuilder canonicalPath = new StringBuilder();
        for (String dir : stack) {
            canonicalPath.append("/").append(dir);
        }

        // If the stack was empty, return the root "/"
        return canonicalPath.length() == 0 ? "/" : canonicalPath.toString();
    }
}
